# Preserve LF line endings on all config files regardless of platform.
# Without this, git autocrlf on Windows converts to CRLF on checkout,
# which breaks Wazuh's csyslogd XML parser and similar strict parsers
# in Prometheus, Filebeat, and others.
*.conf text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.xml  text eol=lf
*.json text eol=lf
*.cnf  text eol=lf
*.sh   text eol=lf
*.ps1  text eol=lf
